{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "Tactical Pepe Cyber-Deck Dark Slate Design System",
  "version": "1.4.0",
  "colors": {
    "canvas": "#0A0E12",
    "panel": "#11171D",
    "panel_row": "#161E26",
    "panel_hover": "#161E26",
    "border": "#243241",
    "border_hover": "#364B60",
    "text_primary": "#E6EDF3",
    "text_muted": "#A3B3C0",
    "primary_banana": "#E48716",
    "text_on_banana": "#0A0E12",
    "success_pepe": "#E48716",
    "alert_magenta": "#F26D6D",
    "telemetry_cyan": "#38BDF8",
    "focus_ring": "#E48716",
    "primary": "#E48716",
    "primary_hover": "#F09527",
    "primary_pressed": "#C5720E",
    "text_on_primary": "#0A0E12",
    "info": "#38BDF8",
    "success": "#4ADE80",
    "danger": "#F26D6D"
  },
  "typography": {
    "tier_1": {
      "name": "Main View Title",
      "font_family_web": "var(--font-cyber)",
      "font_family_desktop": "Segoe UI",
      "size_px": 16,
      "weight": "bold",
      "transform": "uppercase",
      "letter_spacing": "0.08em",
      "color": "#E6EDF3",
      "line_height": 1.3
    },
    "tier_2": {
      "name": "Sub-Section Card Header",
      "font_family_web": "var(--font-cyber)",
      "font_family_desktop": "Segoe UI",
      "size_px": 13,
      "weight": "bold",
      "transform": "uppercase",
      "letter_spacing": "0.05em",
      "color": "#E48716",
      "line_height": 1.35
    },
    "tier_3": {
      "name": "Row Title / Setting Label",
      "font_family_web": "var(--font-tech)",
      "font_family_desktop": "Segoe UI",
      "size_px": 14,
      "weight": "semibold",
      "transform": "none",
      "letter_spacing": "normal",
      "color": "#E6EDF3",
      "line_height": 1.4
    },
    "tier_4": {
      "name": "Description / Logs / Body",
      "font_family_web": "var(--font-tech)",
      "font_family_desktop": "Segoe UI",
      "size_px": 12,
      "weight": "regular",
      "transform": "none",
      "letter_spacing": "normal",
      "color": "#A3B3C0",
      "line_height": 1.45
    },
    "tier_5": {
      "name": "Badge / Monospace Telemetry",
      "font_family_web": "var(--font-code)",
      "font_family_desktop": "Consolas",
      "size_px": 11,
      "weight": "bold",
      "transform": "uppercase",
      "letter_spacing": "0.05em",
      "color": "#E48716",
      "line_height": 1.2
    }
  },
  "spacing": {
    "card_padding": "16px",
    "card_gap": "12px",
    "row_padding": "12px",
    "corner_radius": "8px"
  },
  "components": {
    "button_34": {
      "height_px": 34,
      "padding": "6px 14px",
      "font_tier": 3,
      "corner_radius": "6px"
    },
    "bento_card": {
      "bg": "#11171D",
      "border": "1px solid #243241",
      "padding": "16px",
      "corner_radius": "8px"
    }
  }
}
